APP_ENV=development

# Use "real" on hardware days and "mock" for laptop-only tests.
CONVEYOR_MODE=real
VISION_MODE=real
ROBOT_MODE=real
VOICE_MODE=text

SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DB_PATH=./data/factory.db
DETECTION_DEDUPE_WINDOW_SEC=8.0
DETECTION_DEDUPE_IOU_THRESHOLD=0.5
DETECTION_DEDUPE_CENTER_DISTANCE_PX=70

# Raspberry Pi conveyor HTTP bridge.
RPI_BASE_URL=http://192.168.110.151:5000

# MJPEG streams from web_video_server or another camera stream server.
MJPEG_STREAM_URL=http://localhost:8080/stream
REALSENSE_STREAM_URL=http://localhost:8080/stream?topic=/detection_image
TURTLEBOT_VIEW_URL=http://192.168.110.173:8081/stream?topic=/image_raw

# ROS2 monitoring bridge.
ROS_ENABLED=true
ROS_DOMAIN_ID=33
TURTLEBOT_NAMESPACE=turtlebot3

# Dashboard Start Monitoring command. Hardware bringup should already be running.
AQIS_START_COMMAND=bash /home/ssafy/git/AQIS-for-SmartFactory/AQIS-real/scripts/monitoring_session.sh

# Dobot pick/place command and calibrated coordinates.
DOBOT_PICK_PLACE_COMMAND=python3 /home/ssafy/git/AQIS-for-SmartFactory/AQIS-real/scripts/dobot_pick_place_once.py
DOBOT_PICK_X=125.0
DOBOT_PICK_Y=-180.0
DOBOT_PICK_Z=-5.8
DOBOT_PLACE_X=150.0
DOBOT_PLACE_Y=190.0
DOBOT_PLACE_Z=20.0
DOBOT_SAFE_Z=50.0
DOBOT_HOME_X=200.0
DOBOT_HOME_Y=0.0
DOBOT_HOME_Z=100.0
DOBOT_TOOL_R=7.0
DOBOT_MOTION_TYPE=1
DOBOT_VELOCITY_RATIO=0.2
DOBOT_ACCELERATION_RATIO=0.2
DOBOT_SUCTION_SETTLE_SEC=0.35
DOBOT_RESUME_CONVEYOR_AFTER_PICK=true
DOBOT_PICK_AFTER_STOP_DELAY_SEC=0.6
DOBOT_PICK_MAX_DETECTION_AGE_SEC=3.0
DOBOT_DYNAMIC_PICK_ENABLED=true
DOBOT_DYNAMIC_PICK_Z=-7.8
DOBOT_DYNAMIC_TOOL_R=7.0
DOBOT_DYNAMIC_PICK_OFFSET_X_MM=0.0
DOBOT_DYNAMIC_PICK_OFFSET_Y_MM=0.0
DOBOT_DYNAMIC_PICK_OFFSET_Z_MM=0.0
DOBOT_CAMERA_TO_DOBOT_X_CAM_X=0.06923808
DOBOT_CAMERA_TO_DOBOT_X_CAM_Y=1.05444383
DOBOT_CAMERA_TO_DOBOT_X_BIAS=0.23200291
DOBOT_CAMERA_TO_DOBOT_Y_CAM_X=0.76906914
DOBOT_CAMERA_TO_DOBOT_Y_CAM_Y=0.09692414
DOBOT_CAMERA_TO_DOBOT_Y_BIAS=0.02651858
DOBOT_DYNAMIC_Z_ENABLED=true
DOBOT_CAMERA_TO_DOBOT_Z_CAM_X=-0.02862024
DOBOT_CAMERA_TO_DOBOT_Z_CAM_Y=0.05172572
DOBOT_CAMERA_TO_DOBOT_Z_BIAS=-0.00744611

# Optional navigation coordinates used by higher-level command handlers.
HOME_POSE_X=0.0
HOME_POSE_Y=0.0
DROPOFF_POSE_X=3.0
DROPOFF_POSE_Y=2.0

# Local LLM proxy settings. Keep real keys only in server/.env.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=Qwen3.6-35B-A3B-UD-IQ2_M
LLM_TIMEOUT_SEC=8

WHISPER_MODEL=base

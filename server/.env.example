APP_ENV=development

# Use "real" on hardware days and "mock" for laptop-only tests.
CONVEYOR_MODE=real
VISION_MODE=real
ROBOT_MODE=real
VOICE_MODE=text

SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DB_PATH=./data/factory.db
DEFECT_COUNT_THRESHOLD=3
DETECTION_DEDUPE_WINDOW_SEC=8.0
DETECTION_DEDUPE_IOU_THRESHOLD=0.5
DETECTION_DEDUPE_CENTER_DISTANCE_PX=70

# Raspberry Pi conveyor HTTP bridge.
RPI_BASE_URL=http://192.168.110.151:5000

# MJPEG streams from web_video_server or another camera stream server.
MJPEG_STREAM_URL=http://localhost:8080/stream
REALSENSE_STREAM_URL=http://localhost:8080/stream?topic=/detection_image
TURTLEBOT_VIEW_URL=http://192.168.110.173:8081/stream?topic=/image_raw

# ROS2 monitoring bridge.
ROS_ENABLED=true
ROS_DOMAIN_ID=33
TURTLEBOT_NAMESPACE=turtlebot3

# Dashboard Start Monitoring command. Hardware bringup should already be running.
AQIS_START_COMMAND=bash /home/ssafy/git/AQIS-for-SmartFactory/AQIS-real/scripts/monitoring_session.sh

# Optional navigation coordinates used by higher-level command handlers.
HOME_POSE_X=0.0
HOME_POSE_Y=0.0
DROPOFF_POSE_X=3.0
DROPOFF_POSE_Y=2.0

# Local LLM proxy settings. Keep real keys only in server/.env.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=Qwen3.6-35B-A3B-UD-IQ2_M
LLM_TIMEOUT_SEC=8

WHISPER_MODEL=base
